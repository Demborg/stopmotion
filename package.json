{
  "name": "stopmotion",
  "private": true,
  "type": "module",
  "description": "Dev-only: pins the vendored browser libraries. The site itself has no build step.",
  "scripts": {
    "vendor": "cp node_modules/mqtt/dist/mqtt.esm.js node_modules/qrcode-generator/qrcode.js vendor/",
    "serve": "python3 -m http.server 8765 --bind 127.0.0.1"
  },
  "devDependencies": {
    "mqtt": "5.10.4",
    "qrcode-generator": "1.4.4"
  }
}
